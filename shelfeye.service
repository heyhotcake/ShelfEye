[Unit]
Description=ShelfEye Tool Monitoring System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naniwa
WorkingDirectory=/home/naniwa/ShelfEye
ExecStart=/home/naniwa/ShelfEye/pi-startup.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables (loaded from .env.pi in startup script)
Environment="PATH=/home/naniwa/.nvm/versions/node/v20.18.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resource limits for long-term reliability
LimitNOFILE=65536

# CPU limit: 380% = 3.8 cores out of 4 (leaves 0.2 for OS)
CPUQuota=380%

# Memory limits for 2GB Raspberry Pi
MemoryHigh=1.5G     # Soft limit - triggers swapping/slowdown warning
MemoryMax=1.8G      # Hard limit - process killed if exceeded

# Restart safety: prevent infinite restart loops
StartLimitBurst=5         # Max 5 restart attempts
StartLimitIntervalSec=600 # Within 10 minutes
# If app crashes 5 times in 10 min, systemd gives up

[Install]
WantedBy=multi-user.target
